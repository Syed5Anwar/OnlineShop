{
  "name": "trendkart-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:backend": "cd backend && npm install --include=dev",
    "build:frontend": "cd frontend && npm install --include=dev && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "dist": "npm run build",
    "start": "cd backend && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.4",
    "stripe": "^14.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
